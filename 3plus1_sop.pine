//@version=5
// 3+1 SOP 解答版：對應 index.html 遊戲裡的規則（5 分 K）
//   1. 連招：同方向的 CH / BOS / FVG / OB 出現 3 種以上（反向 FVG 忽略；反向 CH/BOS/OB 重置）
//      BOS 必須收在「CH 之後的最高點（做空：最低點）」之外才算有效
//   2. 回踩：價格碰到最近的同向 OB（OB1），OB2 為防守位
//   3. 進場：碰 OB 後 3 根內出現吞噬 K 棒收線
//        - 實體 >= 0.5 ATR，做多收在前一根高點之上（做空：低點之下）
//        - 收盤價站上前 N 根各自的實體中點（做空：跌破）
//        - （選用）碰到 OB1 且收在 OB 之外
//   4. 停損：OB2 外側（沒有 OB2 用 OB1）；停利：R 倍風險
strategy("3+1 SOP 解答版", overlay=true, initial_capital=10000,
     default_qty_type=strategy.cash, default_qty_value=1000,
     commission_type=strategy.commission.percent, commission_value=0.05,
     process_orders_on_close=true, pyramiding=0,
     max_bars_back=500, max_labels_count=500, max_lines_count=500)

rr       = input.float(1.0, "停利 R（0 = 不設停利）", minval=0.0, step=0.5)
bodyN    = input.int(3, "進場價須站上前 N 根的實體中點", minval=1, maxval=6)
rejectOb = input.bool(true, "進場 K 棒須碰到 OB1 並收在 OB 之外")
showLbl  = input.bool(true, "顯示進場標籤與 SL / TP 線")
showEv   = input.bool(true, "顯示 CH / BOS 標記")

atrv = ta.atr(14)

// ---------- 狀態 ----------
var int   trend = 0
var float lastHp = na
var int   lastHi = na
var bool  lastHbroken = false
var float lastLp = na
var int   lastLi = na
var bool  lastLbroken = false
var int   chIdx = -1
var float sinceHigh = na
var float sinceLow = na

var array<int>   obDir = array.new_int()
var array<float> obHi  = array.new_float()
var array<float> obLo  = array.new_float()

// SOP 連招狀態
var int  cDir = 0
var bool hCH = false
var bool hBOS = false
var bool hFVG = false
var bool hOB = false
var bool cUsed = false
var int  cTouch = -1
var int  cArmed = -1
var int  sigCount = 0

// 每根 K 棒的事件佇列（type: 1=CH 2=BOS 3=FVG 4=OB）
var array<int> sigDir = array.new_int()
var array<int> sigTyp = array.new_int()
array.clear(sigDir)
array.clear(sigTyp)

bool evCHb = false
bool evCHs = false
bool evBOSb = false
bool evBOSs = false
bool evBOSbBad = false
bool evBOSsBad = false

// ---------- 吞噬進場條件 ----------
f_engulf(int d, float obHiV, float obLoV) =>
    bool ok = bar_index >= bodyN and not na(atrv) and math.abs(close - open) >= 0.5 * atrv
    if ok
        if d == 1
            ok := close > open and close > high[1]
        else
            ok := close < open and close < low[1]
    if ok
        for m = 1 to bodyN
            float mid = (open[m] + close[m]) / 2
            if (d == 1 and close <= mid) or (d == -1 and close >= mid)
                ok := false
    if ok and rejectOb
        if d == 1
            ok := low <= obHiV and close > obHiV
        else
            ok := high >= obLoV and close < obLoV
    ok

// ---------- 1. 擺動高低點（左右各 3 根，延遲 3 根確認） ----------
bool isH = bar_index >= 6 and high[3] > high[4] and high[3] > high[5] and high[3] > high[6] and high[3] >= high[2] and high[3] >= high[1] and high[3] >= high[0]
bool isL = bar_index >= 6 and low[3] < low[4] and low[3] < low[5] and low[3] < low[6] and low[3] <= low[2] and low[3] <= low[1] and low[3] <= low[0]
if isH
    lastHp := high[3]
    lastHi := bar_index - 3
    lastHbroken := false
if isL
    lastLp := low[3]
    lastLi := bar_index - 3
    lastLbroken := false

// ---------- 2. OB 失效（收盤穿越遠端邊界） ----------
int nOb = array.size(obDir)
if nOb > 0
    for i = nOb - 1 to 0 by -1
        int d0 = array.get(obDir, i)
        if (d0 == 1 and close < array.get(obLo, i)) or (d0 == -1 and close > array.get(obHi, i))
            array.remove(obDir, i)
            array.remove(obHi, i)
            array.remove(obLo, i)

// ---------- 3. 結構突破（以收盤） ----------
bool newBullOb = false
bool newBearOb = false

if not na(lastHp) and not lastHbroken and close > lastHp
    bool isCH = trend == -1
    bool valid = true
    if isCH
        chIdx := bar_index
    else if chIdx >= 0
        valid := close > sinceHigh
    if valid
        array.push(sigDir, 1)
        array.push(sigTyp, isCH ? 1 : 2)
    if isCH
        evCHb := true
    else if valid
        evBOSb := true
    else
        evBOSbBad := true
    trend := 1
    lastHbroken := true
    // Bull OB：這段上漲的起點附近，最後一根陰線
    int stB = math.max(bar_index - 60, na(lastLi) ? lastHi : math.min(lastLi, lastHi))
    int span = bar_index - stB
    int jOff = span
    float minL = low[span]
    if span > 0
        for off = span - 1 to 0 by -1
            if low[off] < minL
                minL := low[off]
                jOff := off
    int obOff = jOff
    int lim = math.min(jOff + 3, span)
    for off = jOff to lim
        if close[off] < open[off]
            obOff := off
            break
    array.push(obDir, 1)
    array.push(obHi, high[obOff])
    array.push(obLo, low[obOff])
    newBullOb := true

if not na(lastLp) and not lastLbroken and close < lastLp
    bool isCH = trend == 1
    bool valid = true
    if isCH
        chIdx := bar_index
    else if chIdx >= 0
        valid := close < sinceLow
    if valid
        array.push(sigDir, -1)
        array.push(sigTyp, isCH ? 1 : 2)
    if isCH
        evCHs := true
    else if valid
        evBOSs := true
    else
        evBOSsBad := true
    trend := -1
    lastLbroken := true
    // Bear OB：這段下跌的起點附近，最後一根陽線
    int stS = math.max(bar_index - 60, na(lastHi) ? lastLi : math.min(lastHi, lastLi))
    int spanS = bar_index - stS
    int jOffS = spanS
    float maxH = high[spanS]
    if spanS > 0
        for off = spanS - 1 to 0 by -1
            if high[off] > maxH
                maxH := high[off]
                jOffS := off
    int obOffS = jOffS
    int limS = math.min(jOffS + 3, spanS)
    for off = jOffS to limS
        if close[off] > open[off]
            obOffS := off
            break
    array.push(obDir, -1)
    array.push(obHi, high[obOffS])
    array.push(obLo, low[obOffS])
    newBearOb := true

// 事件順序：結構事件 → 新 OB → 新 FVG
if newBullOb
    array.push(sigDir, 1)
    array.push(sigTyp, 4)
if newBearOb
    array.push(sigDir, -1)
    array.push(sigTyp, 4)

// ---------- 4. FVG ----------
bool fvgBull = bar_index >= 2 and not na(atrv) and low > high[2] and (low - high[2]) > 0.1 * atrv
bool fvgBear = not fvgBull and bar_index >= 2 and not na(atrv) and high < low[2] and (low[2] - high) > 0.1 * atrv
if fvgBull
    array.push(sigDir, 1)
    array.push(sigTyp, 3)
if fvgBear
    array.push(sigDir, -1)
    array.push(sigTyp, 3)

// ---------- 5. 連招狀態機 ----------
int nSig = array.size(sigDir)
if nSig > 0
    for i = 0 to nSig - 1
        int sd = array.get(sigDir, i)
        int sty = array.get(sigTyp, i)
        if sd == cDir
            if sty == 1
                hCH := true
            else if sty == 2
                hBOS := true
            else if sty == 3
                hFVG := true
            else
                hOB := true
            if cUsed and (sty == 1 or sty == 2)
                cUsed := false
                cTouch := -1
                cArmed := -1
        else if sty == 3 and cDir != 0
            cDir := cDir   // 反向 FVG：忽略
        else
            cDir := sd
            hCH := sty == 1
            hBOS := sty == 2
            hFVG := sty == 3
            hOB := sty == 4
            cUsed := false
            cTouch := -1
            cArmed := -1

int cnt = (hCH ? 1 : 0) + (hBOS ? 1 : 0) + (hFVG ? 1 : 0) + (hOB ? 1 : 0)
bool armed = cDir != 0 and cnt >= 3 and not cUsed
if armed and cArmed < 0
    cArmed := bar_index

// ---------- 6. 回踩 OB1 → 吞噬進場 ----------
bool goSig = false
float slP = na
float tpP = na
if armed
    int o1 = -1
    int o2 = -1
    float k1 = na
    float k2 = na
    int nO = array.size(obDir)
    if nO > 0
        for i = 0 to nO - 1
            if array.get(obDir, i) == cDir
                float h = array.get(obHi, i)
                float l = array.get(obLo, i)
                bool sideOk = cDir == 1 ? l < close : h > close
                if sideOk
                    float key = cDir == 1 ? h : -l
                    if o1 == -1 or key > k1
                        o2 := o1
                        k2 := k1
                        o1 := i
                        k1 := key
                    else if o2 == -1 or key > k2
                        o2 := i
                        k2 := key
    if o1 != -1
        float ob1Hi = array.get(obHi, o1)
        float ob1Lo = array.get(obLo, o1)
        if (cDir == 1 and low <= ob1Hi) or (cDir == -1 and high >= ob1Lo)
            cTouch := bar_index
        if cTouch >= 0 and bar_index - cTouch <= 3 and f_engulf(cDir, ob1Hi, ob1Lo)
            int ref = o2 != -1 ? o2 : o1
            float sl = cDir == 1 ? array.get(obLo, ref) : array.get(obHi, ref)
            float risk = (close - sl) * cDir
            if risk > 0
                goSig := true
                slP := sl
                tpP := rr > 0 ? close + cDir * risk * rr : na
                cUsed := true

if goSig
    sigCount += 1
    if showLbl
        label.new(bar_index, cDir == 1 ? low : high, "#" + str.tostring(sigCount) + (cDir == 1 ? " 做多" : " 做空") + "\n" + str.tostring(close, format.mintick),
             style=cDir == 1 ? label.style_label_up : label.style_label_down,
             color=cDir == 1 ? color.new(color.teal, 0) : color.new(color.red, 0), textcolor=color.white, size=size.small)
        line.new(bar_index, slP, bar_index + 12, slP, color=color.red, style=line.style_dashed)
        if not na(tpP)
            line.new(bar_index, tpP, bar_index + 12, tpP, color=color.teal, style=line.style_dashed)
    if strategy.position_size == 0
        strategy.entry("SOP", cDir == 1 ? strategy.long : strategy.short)
        strategy.exit("SOP出場", "SOP", stop=slP, limit=tpP)

// ---------- 7. 更新「CH 之後」的極值（供下一根的 BOS 判斷） ----------
if chIdx == bar_index
    sinceHigh := high
    sinceLow := low
else if chIdx >= 0
    sinceHigh := math.max(sinceHigh, high)
    sinceLow := math.min(sinceLow, low)

// ---------- 標記 ----------
plotshape(showEv and evCHb, "CH↑", shape.triangleup, location.belowbar, color.green, text="CH", size=size.tiny)
plotshape(showEv and evCHs, "CH↓", shape.triangledown, location.abovebar, color.red, text="CH", size=size.tiny)
plotshape(showEv and evBOSb, "BOS↑", shape.triangleup, location.belowbar, color.new(color.green, 40), text="BOS", size=size.tiny)
plotshape(showEv and evBOSs, "BOS↓", shape.triangledown, location.abovebar, color.new(color.red, 40), text="BOS", size=size.tiny)
plotshape(showEv and evBOSbBad, "BOS↑未過CH高", shape.xcross, location.belowbar, color.gray, size=size.tiny)
plotshape(showEv and evBOSsBad, "BOS↓未過CH低", shape.xcross, location.abovebar, color.gray, size=size.tiny)
